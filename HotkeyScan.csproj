<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotkeyScan</RootNamespace>
    <AssemblyName>HotkeyScan</AssemblyName>

    <Version>1.0.6</Version>
    <Product>HotkeyScan</Product>
    <Description>Finds which running program is holding a hotkey</Description>

    <!-- One self-contained file: it has to run on a PC with no .NET installed.
         No InvariantGlobalization: WPF reads the input language culture and dies without it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF ships native DLLs; without this they stay next to the exe instead of inside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- "Find the owner": the native hook rides inside the exe and is extracted only while it runs. -->
  <ItemGroup>
    <NativeHook Include="native\bin\hook64.dll;native\bin\hook32.dll;native\bin\host32.exe"/>
    <EmbeddedResource Include="@(NativeHook)" LogicalName="%(Filename)%(Extension)"/>
  </ItemGroup>

  <Target Name="BuildNativeHook" BeforeTargets="BeforeBuild"
          Inputs="native\hook.c;native\host32.c;native\build.cmd" Outputs="@(NativeHook)">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\native\build.cmd&quot;"/>
  </Target>

</Project>
