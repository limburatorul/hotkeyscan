<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotkeyScan</RootNamespace>
    <AssemblyName>HotkeyScan</AssemblyName>

    <Version>1.0.0</Version>
    <Product>HotkeyScan</Product>
    <Description>Finds which running program is holding a hotkey</Description>

    <!-- One self-contained file: it has to run on a PC with no .NET installed.
         No InvariantGlobalization: WPF reads the input language culture and dies without it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF ships native DLLs; without this they stay next to the exe instead of inside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
