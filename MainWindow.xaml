<Window x:Class="HotkeyScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotkeyScan" Height="720" Width="1020" MinHeight="560" MinWidth="880"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <DockPanel Grid.ColumnSpan="2" Margin="2,0,0,14">
      <Button DockPanel.Dock="Right" Content="Key monitor" VerticalAlignment="Center"
              Margin="0,0,2,0" Click="Monitor_Click"
              ToolTip="For a key that misbehaves on its own, not a whole shortcut."/>
      <StackPanel>
        <TextBlock Text="HotkeyScan" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="Which running program is holding a hotkey captive."/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
          <TextBlock.Resources><Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style></TextBlock.Resources>
          Feedback: <Hyperlink NavigateUri="mailto:feedback@protagonistlabs.app?subject=HotkeyScan%20feedback" RequestNavigate="Link_Navigate">feedback@protagonistlabs.app</Hyperlink>
          · <Hyperlink NavigateUri="https://protagonistlabs.app/hotkeyscan/?utm_source=hotkeyscan&amp;utm_medium=app&amp;utm_campaign=header" RequestNavigate="Link_Navigate">Website</Hyperlink>
          · <Hyperlink NavigateUri="https://protagonistlabs.app/?utm_source=hotkeyscan&amp;utm_medium=app&amp;utm_campaign=more-apps" RequestNavigate="Link_Navigate">More apps from Protagonist Labs</Hyperlink>
        </TextBlock>
        <!-- the sister apps that send their taken hotkeys here; filled in from their cards -->
        <Expander Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="12">
          <Expander.Header><TextBlock Text="Works with" Style="{StaticResource Hint}"/></Expander.Header>
          <TextBlock x:Name="WorksText" Style="{StaticResource Hint}" Margin="18,2,0,0">
            <TextBlock.Resources>
              <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline"/></Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Resources>
          </TextBlock>
        </Expander>
        <!-- shown once HotkeyScan has answered something: one app we make, with a code for its users -->
        <TextBlock x:Name="OfferLine" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed">
          <TextBlock.Resources><Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style></TextBlock.Resources>
          Play PC games? <Hyperlink NavigateUri="https://protagonistlabs.app/shelf/?code=FREEAPP30&amp;utm_source=hotkeyscan&amp;utm_medium=app&amp;utm_campaign=recommend#pricing" RequestNavigate="Link_Navigate">Shelf</Hyperlink>, our game library that also backs up your saves, is 30% off for HotkeyScan users.
        </TextBlock>
        <TextBlock x:Name="UpdateLine" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </DockPanel>

    <!-- the combination -->
    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,12,12">
      <StackPanel>
        <TextBlock Text="HOTKEY" Style="{StaticResource Label}"/>
        <DockPanel>
          <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find the owner" Margin="8,0,0,0"
                  IsEnabled="False" Click="Find_Click"
                  ToolTip="Briefly hooks running programs and waits for you to press the combination, then names the program that receives it."/>
          <Button x:Name="PressButton" DockPanel.Dock="Right" Content="Press it" Margin="8,0,0,0"
                  IsEnabled="False" Click="Press_Click"
                  ToolTip="Presses the combination for real and watches which process answers."/>
          <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0"
                  Style="{StaticResource Primary}" IsDefault="True" IsEnabled="False" Click="Check_Click"/>
          <TextBox x:Name="HotkeyBox" FontSize="15" FontWeight="SemiBold"
                   PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextChanged="HotkeyBox_TextChanged"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Click the box and press the combination, or type it (Ctrl+Alt+S, or double-tap Win). Combinations Windows swallows first, like Win+L, have to be typed. Check tells you if it's taken; Find the owner names who reserved it; Press it shows who reacts to it."/>
      </StackPanel>
    </Border>

    <!-- verdict -->
    <Border x:Name="VerdictCard" Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,12,12"
            Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="VERDICT" Style="{StaticResource Label}"/>
        <ItemsControl x:Name="VerdictList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Paint}"
                           TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="TellButton" Content="Not recognised? Tell us" HorizontalAlignment="Left"
                Margin="120,2,0,0" Visibility="Collapsed" Click="Tell_Click"
                ToolTip="Shows the report first; you can cut lines, and your mail client sends it, not HotkeyScan."/>
      </StackPanel>
    </Border>

    <!-- sweep -->
    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="EVERY COMBINATION" Style="{StaticResource Label}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button x:Name="ScanButton" DockPanel.Dock="Left" Content="Scan them all" Click="Scan_Click"/>
          <CheckBox x:Name="OnlyUnknown" DockPanel.Dock="Left" Margin="12,0,0,0"
                    Content="only unknown owners" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
          <TextBox x:Name="FilterBox" Margin="12,0,0,0" TextChanged="Filter_Changed"
                   ToolTip="Filter by combination or owner"/>
        </DockPanel>
        <ListView x:Name="Results" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  FontFamily="Segoe UI" FontSize="12"
                  MouseDoubleClick="Results_MouseDoubleClick">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Hotkey" Width="160" DisplayMemberBinding="{Binding Hotkey}"/>
              <GridViewColumn Header="Owner" Width="420" DisplayMemberBinding="{Binding Owner}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Border>

    <!-- running apps -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource CardPanel}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="RUNNING APPS THAT TAKE HOTKEYS" Style="{StaticResource Label}"/>
        <ItemsControl x:Name="AppsList">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Mechanism}" Foreground="{Binding Paint}" FontSize="11"/>
                <TextBlock Text="{Binding Defaults}" Style="{StaticResource Hint}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <TextBlock x:Name="Status" Grid.Row="4" Grid.ColumnSpan="2" Margin="2,12,0,0"
               Style="{StaticResource Hint}"/>
  </Grid>
</Window>
